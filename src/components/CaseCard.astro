---
import type { Project } from '../lib/types';
import CaseFootnote from './CaseFootnote.tsx';
interface Props { project: Project; index: number; }
const { project, index } = Astro.props;
const num = String(index + 1).padStart(2, '0');
// Meta line below the giant number: language + first two topics + year.
const metaParts = [project.language, ...project.topics.slice(0, 2), project.year].filter(Boolean);
---
<article class="case-row">
  <div class="container-x case-grid">
    <div>
      <div class="case-num tnum" aria-hidden="true"><span class="lead">{num[0]}</span>{num[1]}</div>
      <div class="label" style="margin-top:14px;letter-spacing:.16em;">{metaParts.join(' · ')}</div>
    </div>
    <div class="min-w-0">
      <a href={project.url} target="_blank" rel="noopener noreferrer" class="case-title-link">
        <h3 class="case-title">{project.name}</h3>
      </a>
      <p class="case-story" style="margin:20px 0 0;font-size:17px;">{project.story}</p>
      <div class="reflection" style="margin:26px 0;">
        <p>{project.reflection.text}</p>
      </div>
      {project.footnote && (
        <CaseFootnote
          prompt={project.footnote.prompt}
          cmd={project.footnote.cmd}
          note={project.footnote.note}
          action={project.footnote.action}
          client:visible
        />
      )}
    </div>
  </div>
</article>
