---
import type { Project } from '../lib/types';
import OpenbootDashboard from './OpenbootDashboard.astro';
import CaseFootnote from './CaseFootnote.tsx';
interface Props { project: Project; index: number; }
const { project, index } = Astro.props;
const num = String(index + 1).padStart(2, '0');
// Meta line below the project number: language + first two topics + year.
const metaParts = [project.language, ...project.topics.slice(0, 2), project.year].filter(Boolean);
---
<article class="case-row">
  <div class="case-grid">
    <div>
      <div class="case-num tnum" aria-hidden="true">{num}</div>
      <div class="label case-meta">{metaParts.join(' · ')}</div>
    </div>
    <div class="min-w-0">
      <a href={project.url} target="_blank" rel="noopener noreferrer" class="case-title-link">
        <h3 class="case-title">{project.name}<span class="case-arrow" aria-hidden="true">↗</span></h3>
      </a>
      <p class="case-story">{project.story}</p>
      <div class="reflection">
        <p>{project.reflection.text}</p>
      </div>
      {project.footnote && (
        <CaseFootnote
          prompt={project.footnote.prompt}
          cmd={project.footnote.cmd}
          note={project.footnote.note}
          action={project.footnote.action}
          client:visible
        />
      )}
      {project.hasDashboard && <OpenbootDashboard />}
    </div>
  </div>
</article>
