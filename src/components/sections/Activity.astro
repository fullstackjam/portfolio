---
import type { ContributionDay } from '../../lib/types';
import Heatmap from '../Heatmap.tsx';
import RevealText from '../RevealText.tsx';
import Reveal from '../Reveal.tsx';
interface Props { contributions: ContributionDay[]; total: number; }
const { contributions, total } = Astro.props;
---
{contributions.length > 0 && (
  <section id="activity" class="container-x py-28 sm:py-40 border-t hairline">
    <div class="flex items-baseline justify-between">
      <p class="label">04 — Activity</p>
      <p class="label hidden sm:block">Last 12 months</p>
    </div>
    <h2 class="serif text-[clamp(2.4rem,6vw,5.5rem)] mt-8 mb-14 sm:mb-20">
      <RevealText text={`${total} contributions, still counting.`} accent="counting." client:visible />
    </h2>
    <Reveal client:visible>
      <div class="border hairline p-5 sm:p-8" style="background: var(--surface)">
        <Heatmap days={contributions} />
        <div class="flex items-center gap-2 mt-6">
          <span class="label">less</span>
          {[0, 1, 2, 3, 4].map((l) => (
            <span class="w-[10px] h-[10px] rounded-[2px]" style={`background: var(--hm-${l})`}></span>
          ))}
          <span class="label">more</span>
        </div>
      </div>
    </Reveal>
  </section>
)}
