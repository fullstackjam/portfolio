---
import type { Project } from '../../lib/types';
import CaseCard from '../CaseCard.astro';
interface Props { projects: Project[]; }
const { projects } = Astro.props;

// Every curated project gets a full case row.
const count = String(projects.length).padStart(2, '0');
---
<section id="work" class="container-x section-pad">
  <div style="display:flex;align-items:baseline;justify-content:space-between;margin-bottom:28px;">
    <span class="label">Selected work</span>
    <span class="label tnum">{count} — curated</span>
  </div>

  {projects.length > 0
    ? projects.map((project, i) => <CaseCard project={project} index={i} />)
    : <p class="muted">Projects are loading — check back in a moment.</p>
  }

  <div
    style="padding:36px 0 0;border-top:1px solid var(--rule);display:flex;justify-content:flex-end;font-family:var(--font-mono);font-size:12.5px;letter-spacing:.04em;"
  >
    <a
      href="https://github.com/fullstackjam?tab=repositories"
      target="_blank"
      rel="noopener noreferrer"
      class="ul"
      style="color:var(--fg);text-decoration:none;padding-bottom:3px;"
    >see all repositories <span aria-hidden="true" class="accent">↗</span></a>
  </div>
</section>
