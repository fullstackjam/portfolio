---
import { EXPERIENCE } from '../../data/resume';
---
<section id="experience" class="container-x py-20 sm:py-28 border-t hairline">
  <p class="label">Experience</p>
  <div class="mt-12 sm:mt-16">
    {EXPERIENCE.map((job, i) => (
      <div class={`grid grid-cols-1 lg:grid-cols-12 gap-x-10 gap-y-6 ${i > 0 ? 'border-t hairline pt-12 sm:pt-16 mt-12 sm:mt-16' : ''}`}>
        <div class="lg:col-span-4">
          <h3 class="serif text-[clamp(1.6rem,2.8vw,2.4rem)] leading-tight">{job.company}</h3>
          <p class="label mt-3 [color:var(--accent)]">{job.role}</p>
          <p class="label tnum mt-2 normal-case tracking-[0.14em]">{job.location} · {job.period}</p>
        </div>
        <div class="lg:col-span-8 lg:col-start-5">
          <ul class="space-y-5">
            {job.bullets.map((b) => (
              <li class="relative pl-7 max-w-2xl leading-relaxed">
                <span class="absolute left-0 top-[0.6em] w-3 h-px bg-[var(--accent)]" aria-hidden="true"></span>
                {b}
              </li>
            ))}
          </ul>
        </div>
      </div>
    ))}
  </div>
</section>
