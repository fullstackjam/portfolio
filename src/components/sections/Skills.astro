---
import { SKILLS } from '../../data/resume';
---
<section id="skills" class="container-x py-20 sm:py-28 border-t hairline">
  <p class="label">Skills</p>
  <div class="mt-12 sm:mt-16">
    {SKILLS.map((g, i) => (
      <div class={`grid grid-cols-1 lg:grid-cols-12 gap-x-10 gap-y-2 py-6 ${i > 0 ? 'border-t hairline' : ''}`}>
        <p class="lg:col-span-4 serif text-[clamp(1.15rem,1.9vw,1.5rem)]">{g.label}</p>
        <p class="lg:col-span-8 lg:col-start-5 leading-relaxed">{g.items.join('  ·  ')}</p>
      </div>
    ))}
  </div>
</section>
