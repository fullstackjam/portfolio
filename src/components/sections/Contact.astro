---
import { SOCIAL_LINKS, OVERRIDES } from '../../data/profile';
const email = SOCIAL_LINKS.find((l) => l.name === 'Email');
const others = SOCIAL_LINKS.filter((l) => l.name !== 'Email');
---
<section id="contact" class="theatre section-pad">
  <div class="container-x">
    <p class="label" style="margin:0 0 40px;color:var(--muted);">Contact</p>
    <h2
      class="display"
      style="font-size:clamp(52px,10vw,118px);line-height:.92;letter-spacing:-.025em;margin:0;max-width:15ch;color:var(--fg);"
    >
      Let's build something <span style="font-style:italic;color:var(--accent);">good</span> together.
    </h2>
    {email && (
      <div style="margin-top:56px;">
        <p class="label" style="margin:0 0 16px;color:var(--muted);">
          {OVERRIDES.availableForWork ? 'Available for work — say hello' : 'Say hello'}
        </p>
        <a
          href={email.url}
          class="serif ul contact-email"
        >
          {email.url.replace('mailto:', '')}
        </a>
      </div>
    )}
    <div class="contact-links">
      {others.map((l, i) => (
        <a
          href={l.url}
          target="_blank"
          rel="noopener noreferrer"
          class="label contact-link"
        >
          <span class="tnum" style="margin-right:8px;opacity:.6;">{String(i + 1).padStart(2, '0')}</span>{l.name} <span aria-hidden="true">↗</span>
          <span class="sr-only">(opens in new tab)</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .contact-email {
    font-style: italic;
    font-size: clamp(26px, 4.4vw, 52px);
    color: var(--fg);
    text-decoration: none;
    padding-bottom: 6px;
    background-size: 100% 1px;
    background-image: linear-gradient(color-mix(in srgb, var(--fg) 25%, transparent), color-mix(in srgb, var(--fg) 25%, transparent));
    transition: color 0.3s ease;
  }
  .contact-email:hover {
    color: var(--accent);
    background-image: linear-gradient(var(--accent), var(--accent));
  }
  .contact-links {
    margin-top: 88px;
    padding-top: 30px;
    border-top: 1px solid var(--rule);
    display: flex;
    flex-wrap: wrap;
    gap: 16px 40px;
  }
  .contact-link { color: var(--muted); text-decoration: none; transition: color 0.2s ease; }
  .contact-link:hover { color: var(--fg); }
</style>
